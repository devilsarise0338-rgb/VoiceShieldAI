# Copy this file to `backend/.env` and fill in your actual private keys.
# DO NOT commit backend/.env to version control!
#
# ⚠️ SECURITY: NEVER prefix these backend secrets with "VITE_".
# Vite bundles VITE_-prefixed variables into client-side JavaScript, exposing them in browser devtools.
# ==============================================================================

# Reality Defender API Key (Metered deepfake detection platform)
REALITY_DEFENDER_API_KEY=""

# Hugging Face Access Token (Gated AI weights & audio model pipelines)
HF_TOKEN=""
