# Supabase configuration (Frontend Client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# AI Detection Backend (Optional FastAPI/Python backend URL)
VITE_AI_BACKEND_URL="http://localhost:8000"
VITE_AI_BACKEND_WS_URL="ws://localhost:8000/ws/v1/live-detection"

# Demo Mode Toggle — real detection OFF unless exactly "true" (GOAL step 4)
# "true"  => simulated heuristic (for offline demo)
# any other value / unset => OFF, frontend calls POST /api/v1/analyses (AASIST CPU)
VITE_ENABLE_DEMO_MODE="false"

